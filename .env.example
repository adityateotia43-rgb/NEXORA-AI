# ===================================================
# NEXORA AI — Environment Variables Configuration
# ===================================================
# Copy this file to '.env' and update the values as needed.
# Do NOT commit actual secrets or production keys to version control.

# ---------------------------------------------------
# 1. Server Configuration
# ---------------------------------------------------
PORT=3000
HOST=localhost
NODE_ENV=development

# ---------------------------------------------------
# 2. Application Metadata
# ---------------------------------------------------
APP_NAME=NEXORA AI
APP_VERSION=v2.4
APP_TAGLINE=Let’s make learning easier.

# ---------------------------------------------------
# 3. AI Provider Abstraction Configuration
# ---------------------------------------------------
# Provider Routing Strategy:
# - 'auto'        : Automatically uses the best configured provider (Gemini -> OpenAI -> Anthropic -> Groq -> Ollama -> Simulation fallback)
# - 'gemini'      : Force Google Gemini
# - 'openai'      : Force OpenAI (GPT-4o, GPT-4o-mini, etc.)
# - 'anthropic'   : Force Anthropic Claude (Claude 3.5 Sonnet / Haiku)
# - 'groq'        : Force Groq Cloud LPU (Llama 3.3, Mixtral)
# - 'ollama'      : Force Local Ollama instance
# - 'simulation'  : Force zero-latency offline cognitive simulation
AI_PROVIDER=auto

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional custom base URL (e.g. for proxies, Azure, or OpenRouter):
OPENAI_BASE_URL=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Groq LPU (Ultra-Fast Inference) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (Local Self-Hosted LLMs) ---
# Set to 'http://localhost:11434' when running Ollama locally
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# --- TMDB (The Movie Database) ---
# Optional: Provide a TMDB API v3 key for live cinema data & movie search
# If omitted or unconfigured, Nexora AI seamlessly uses the built-in Masterpiece Cinema Catalog
TMDB_API_KEY=

# --- Supabase (Cloud Sync, Auth & Row Level Security) ---
# Provide your Supabase Project URL and public Anon Key
# Found in Supabase Dashboard -> Project Settings -> API
# If omitted, Nexora AI runs in Guest/Local Storage mode with zero downtime
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------
# 4. Feature Toggles
# ---------------------------------------------------
# Enable/disable audio features (Web Audio synth & Web Speech API)
ENABLE_AUDIO_SYNTH=true
ENABLE_VOICE_DICTATION=true
ENABLE_OFFLINE_SIMULATION=true

# ---------------------------------------------------
# 5. Default Academic Context
# ---------------------------------------------------
# Initial context when user opens the Study Hub
DEFAULT_TOPIC=Science
DEFAULT_TIER=Undergrad
DEFAULT_LANGUAGE=Hinglish

# ---------------------------------------------------
# 6. Security, Rate Limiting & Timeout Configuration
# ---------------------------------------------------
CORS_ORIGIN=*

# Rate Limiting (Sliding Window per client IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_MS=60000

# Timeouts (in milliseconds)
PROVIDER_TIMEOUT_MS=18000
SERVER_TIMEOUT_MS=35000

# Maximum allowed JSON body size (bytes, default 64KB)
MAX_BODY_SIZE_BYTES=65536
